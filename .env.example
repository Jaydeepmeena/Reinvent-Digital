# The CMS base URL. One variable drives everything the site reads:
#
#   /posts/          the blog            (live)
#   /case-studies/   the case studies    (live)
#   /landing-pages/  the bulk pSEO pages (endpoint still to be built)
#   /services/ /industries/ /locations/ /about/ /resources/ /contact/
#                    the site's own pages (endpoints still to be built)
#
# No trailing slash: the code appends each resource path itself. Works with a
# custom backend returning { <collection>, total, total_pages } or with a stock
# WordPress wp-json base. See docs/cms-api.md and docs/pages-api.md.
#
# Unset, or pointing at an endpoint that is not there yet, is safe: the site
# serves its bundled content instead and nothing breaks.
#
# Vite inlines this at build time, so changing it needs a rebuild, and whatever
# is in here ships inside the public JS bundle. Never put a secret in a VITE_
# variable.
VITE_BLOG_API_URL=https://reinventmedia.in/staging-reinventdigital
