# CMS base URL the site reads the blog and the case studies from. No trailing
# slash: the code appends /posts/ and /case-studies/ itself. Works with a
# custom backend returning { posts | case_studies, total, total_pages } or with
# a stock WordPress wp-json base. See docs/cms-api.md.
VITE_BLOG_API_URL=https://reinventmedia.in/staging-reinventdigital
